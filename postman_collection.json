				{
					"name": "7. Update Courier",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Courier details successfully updated', function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('data');",
									"    pm.expect(jsonData.data.name).to.eql('Budiono Hadi Agung Updated');",
									"    pm.expect(jsonData.data.level).to.eql(4);",
									"    pm.expect(jsonData.data.vehicle_type).to.eql('car');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Budiono Hadi Agung Updated\",\n    \"level\": 4,\n    \"vehicle_type\": \"car\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
